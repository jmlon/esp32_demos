[
  {
    "label": "ESP32-C3: Compile Code",
    "command": "arduino-cli compile -b esp32:esp32:esp32c3:CDCOnBoot=cdc --build-path ./build .",
    "cwd": "$ZED_DIRNAME",
    "description": "Compiles the ESP32 sketch in the active file's directory",
    "use_new_terminal": false,
    "allow_concurrent_runs": false
  },
  {
    "label": "ESP32-C3: Upload Code",
    "command": "arduino-cli upload -p /dev/ttyACM0 -b esp32:esp32:esp32c3 --input-dir ./build .",
    "cwd": "$ZED_DIRNAME",
    "description": "Uploads the compiled binary from the active file's directory",
    "use_new_terminal": false,
    "allow_concurrent_runs": false
  },
  {
    "label": "ESP8266: Compile",
    "command": "arduino-cli compile -b esp8266:esp8266:generic --build-path ./build .",
    "cwd": "$ZED_DIRNAME",
    "description": "Compiles the ESP8266 rtc3231/BMP180 sketch",
    "use_new_terminal": false,
    "allow_concurrent_runs": false
  },
  {
    "label": "ESP8266: Upload",
    "command": "arduino-cli upload -p /dev/ttyUSB0 -b esp8266:esp8266:generic --input-dir ./build .",
    "cwd": "$ZED_DIRNAME",
    "description": "Uploads the ESP8266 rtc3231/BMP180 sketch",
    "use_new_terminal": false,
    "allow_concurrent_runs": false
  },
  {
    "label": "Serial Monitor: /dev/ttyUSB0",
    "command": "arduino-cli monitor -p /dev/ttyUSB0 -c baudrate=115200",
    "description": "Opens a serial monitor on /dev/ttyUSB0",
    "use_new_terminal": true,
    "allow_concurrent_runs": false
  },
  {
    "label": "Serial Monitor: /dev/ttyACM0",
    "command": "arduino-cli monitor -p /dev/ttyACM0 -c baudrate=115200",
    "description": "Opens a serial monitor on /dev/ttyACM0",
    "use_new_terminal": true,
    "allow_concurrent_runs": false
  }
]
